# Copy to .env and fill in. Never commit .env.

# Parse backend (read-only, server-side only; plain HTTP today).
# Values: Maxx mobile repo, src/services/queries.js request interceptor.
PARSE_BASE_URL=http://beanstalk.maxxortho.com/
PARSE_APP_ID=
PARSE_REST_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maxx_media

OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3
LLM_DISABLE_THINKING=true

EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true

# Retrieval tuning: calibrate the thresholds against tests/eval_questions.yaml.
SEARCH_TOP_K=20
RERANK_TOP_K=5
RERANK_THRESHOLD=0.15
VECTOR_THRESHOLD=0.45

# Required to call POST /api/ingest/refresh (endpoint is disabled when empty).
ADMIN_TOKEN=
